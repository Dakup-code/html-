<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>USUAL — Redistributing Value</title>
  
  <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- header -->
  <header class="navbar">
    <a href="#" class="brand" aria-label="USUAL home">
      <span class="brand-mark"></span>
      <span>USUAL</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      <a href="#">Home</a>
      <a href="#">Blog</a>
      <a href="#">Explore</a>
      <a href="#">Company</a>
    </nav>

    <a href="#" class="top-button">Access App</a>
