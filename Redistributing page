    <!-- section partners -->

    <section class="partners" aria-label="Partners">
      <span class="partner coinbase">coinbase</span>
      <span class="partner binance"><b>◆</b> BINANCE<small>LABS</small></span>
      <span class="partner okx">OKX</span>
      <span class="partner galaxy"><b></b> galaxy</span>
      <span class="partner kraken"><b>m</b> KRAKEN<small>VENTURES</small></span>
      <span class="partner circle"><b>◎</b> CIRCLE</span>
