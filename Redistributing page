  <main>
      <!-- main -->
    <section class="hero">
      <div class="hero-copy">
        <h1>Redistributing the<br>value monopolised<br>by crypto giants</h1>
        <p>A secure, decentralised issuer that takes back<br class="desktop"> the value captured by crypto giants.</p>
        <a href="#" class="hero-button">
          <span class="button-mark"></span>
          Access App
        </a>
      </div>
      <!-- hero art -->

      <div class="hero-art" aria-hidden="true">
        <div class="art-frame"></div>
        <div class="platform platform-back"></div>
        <div class="tower">
          <div class="tower-top"></div>
          <div class="tower-front"></div>
          <div class="tower-side"></div>
        </div>
        <div class="sphere sphere-top"></div>
        <div class="platform platform-front"></div>
        <div class="sphere sphere-front"></div>
      </div>
