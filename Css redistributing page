* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #191919;
  --text: #f2f2fa;
  --muted: #8e8e96;
  --line: rgba(255, 255, 255, .18);
  --glass: rgba(255, 255, 255, .045);
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 69% 45%, rgba(255,255,255,.035), transparent 28%),
    var(--bg);
  color: var(--text);
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

.navbar {
  width: min(1190px, calc(100% - 64px));
  margin: 0 auto;
  height: 96px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 17px;
  font-weight: 650;
  letter-spacing: -.02em;
}

.brand-mark,
.button-mark {
  width: 23px;
  height: 23px;
  display: inline-block;
  border: 3px solid #f5f5f5;
  border-right-color: transparent;
  border-radius: 50%;
  transform: rotate(-35deg);
}

.nav-links {
  display: flex;
  gap: 43px;
  margin-left: 95px;
  color: #a0a0a6;
  font-size: 14px;
}

.nav-links a {
  transition: color .2s ease;
}

.nav-links a:hover {
  color: #fff;

}
